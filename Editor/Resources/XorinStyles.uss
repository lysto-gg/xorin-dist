/* ─── Shell (Phase 1) ─── */
.eig-root-panel,
#eig-root-panel,
#root {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
    background-color: #1a1a1a;
}

/* ─── Shared visual contract (Phase 64) ─── */
/* Typography roles. Settings controls need scoped aliases to beat Unity defaults. */
.xorin-modal-title {
    font-size: 16px;
    -unity-font-style: bold;
}

.xorin-panel-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.xorin-section-title {
    font-size: 13px;
    -unity-font-style: bold;
}

.xorin-primary-content,
.xorin-status-glyph {
    font-size: 13px;
}

.xorin-standard-text,
.xorin-standard-control,
.settings-panel .unity-base-field,
.settings-panel Button {
    font-size: 12px;
}

.xorin-secondary-text {
    font-size: 11px;
}

.xorin-caption {
    font-size: 10px;
}

.xorin-sign-in-code {
    font-size: 24px;
}

/* Icon roles. */
.xorin-icon-button,
Button.xorin-icon-button {
    width: 24px;
    min-width: 24px;
    height: 24px;
    min-height: 24px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.xorin-action-icon {
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.82;
}

Button:hover > .xorin-action-icon,
Button:active > .xorin-action-icon {
    opacity: 1;
}

Button:disabled > .xorin-action-icon {
    opacity: 0.35;
}

/* Shared action-button roles. */
.xorin-quiet-icon-button {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 4px;
}

.xorin-quiet-icon-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: transparent;
}

.xorin-quiet-icon-button:active {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: transparent;
}

.xorin-quiet-icon-button:focus {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(120, 170, 255, 0.75);
}

.xorin-action-button {
    margin: 0;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.1s;
}

.xorin-primary-button,
.xorin-secondary-button,
.xorin-danger-button {
    min-height: 28px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.xorin-primary-button {
    background-color: rgba(51, 102, 204, 0.55);
    border-color: transparent;
    color: #f0f0f0;
}

.xorin-primary-button:hover,
.xorin-primary-button:focus {
    background-color: rgba(68, 119, 221, 0.72);
    border-color: rgba(120, 170, 255, 0.75);
    color: white;
}

.xorin-primary-button:active {
    background-color: rgba(68, 119, 221, 0.88);
    scale: 0.97 0.97;
}

.xorin-secondary-button {
    background-color: #303030;
    border-color: #494949;
    color: #d0d0d0;
}

.xorin-secondary-button:hover,
.xorin-secondary-button:focus {
    background-color: #3a3a3a;
    border-color: #666;
    color: white;
}

.xorin-secondary-button:active {
    background-color: #444;
    scale: 0.97 0.97;
}

.xorin-primary-button:disabled,
.xorin-secondary-button:disabled,
.xorin-danger-button:disabled {
    background-color: #282828;
    border-color: #353535;
    color: #666;
}

.xorin-danger-button {
    background-color: transparent;
    border-color: rgba(190, 95, 95, 0.55);
    color: rgba(220, 145, 145, 0.95);
}

.xorin-danger-button:hover,
.xorin-danger-button:focus {
    background-color: rgba(110, 46, 46, 0.55);
    border-color: rgba(220, 105, 105, 0.9);
    color: rgba(240, 165, 165, 1);
}

.xorin-danger-button:active {
    background-color: rgba(125, 52, 52, 0.7);
    scale: 0.97 0.97;
}

.xorin-quiet-text-button {
    height: 24px;
    min-height: 24px;
    padding: 0 4px;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 4px;
    color: rgba(180, 195, 215, 1);
}

.xorin-quiet-text-button:hover,
.xorin-quiet-text-button:focus {
    background-color: rgba(255, 255, 255, 0.07);
    border-color: transparent;
    color: rgba(220, 228, 238, 1);
}

.xorin-quiet-text-button:focus {
    border-color: rgba(120, 170, 255, 0.75);
}

.xorin-quiet-text-button:active {
    background-color: rgba(255, 255, 255, 0.12);
}

.xorin-quiet-text-button:disabled {
    background-color: transparent;
    border-color: transparent;
    color: #666;
}

.xorin-chat-actions > Button {
    margin-left: 4px;
}

.xorin-chat-actions > .xorin-chat-action-first {
    margin-left: 0;
}

.xorin-icon--compact {
    width: 12px;
    height: 12px;
}

.xorin-icon--standard {
    width: 14px;
    height: 14px;
}

.xorin-icon--primary {
    width: 16px;
    height: 16px;
}

.xorin-sign-in-root {
    padding: 16px 20px;
}

.xorin-sign-in-title {
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.xorin-sign-in-code {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.xorin-sign-in-primary-button {
    height: 32px;
}

.xorin-sign-in-button {
    height: 28px;
}

.xorin-info-dialog-root {
    padding: 16px 20px;
    justify-content: center;
}

.xorin-info-dialog-message {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-center;
}

.xorin-info-dialog-button {
    height: 28px;
}

.eig-main-column {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
}

.eig-root-main {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
}

/* ─── Right Panel (Chat History Overlay) ─── */
.right-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 260px;
    flex-direction: column;
    background-color: #1a1a1a;
    border-left-width: 1px;
    border-left-color: #2d2d30;
    translate: 260px 0;
    transition-property: translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.right-panel--open {
    translate: 0px 0;
}

.eig-search-row {
    display: none;
    flex-shrink: 0;
    flex-direction: row;
}

.eig-chat-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-height: 0;
}

.eig-chat-panel-root {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.eig-empty-state-root,
.eig-progress-container,
.eig-drop-zone,
.eig-plan-banner-root {
    display: none;
}

.eig-footer {
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
}

.eig-input-bar {
    width: 100%;
}

.eig-history-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
}

/* Compact docked window (narrow width) */
.eig-compact .eig-empty-state-root {
    display: none;
}

/* ─── Header Bar ─── */
.header-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    position: relative;
    min-height: 36px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: #1e1e1e;
    border-bottom-width: 1px;
    border-bottom-color: #2d2d30;
}

.header-bar-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.header-bar-side--left {
    justify-content: flex-start;
    flex-grow: 1;
}

.header-bar-side--right {
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
}

.header-bar Button,
.header-bar-side {
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
}

.header-bar .xorin-trigger,
.header-bar .new-chat-button,
.header-bar .chat-history-button,
.header-bar .gear-button,
.header-bar .memory-button,
.header-bar .performance-analysis-button {
    border-width: 0;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.header-bar Button.xorin-trigger:hover {
    background-color: var(--unity-colors-button-background-hover);
    border-width: 0;
    border-color: var(--unity-colors-button-border-hover);
}

.header-bar Button.xorin-trigger:active {
    background-color: var(--unity-colors-button-background-hover_pressed);
    border-width: 0;
}

.header-bar .chat-history-button--active {
    background-color: var(--unity-colors-button-background-hover);
    border-width: 0;
}

.header-bar .new-chat-button {
    margin-right: 4px;
}

.header-bar .performance-analysis-button--recording {
    color: #f28b82;
}

.runtime-performance-status-root {
    display: none;
}

.runtime-performance-status {
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(35, 40, 48, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(68, 76, 88, 1);
}

.runtime-performance-status-label {
    flex-grow: 1;
    min-width: 0;
    color: #d5d9e0;
    white-space: normal;
}

.header-bar .chat-title-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-left: 4px;
    min-width: 0;
    min-height: 22px;
}

.header-bar .chat-history-button {
    margin: 0;
}

.header-bar .chat-title-label {
    -unity-font-style: normal;
    color: #e6e6e6;
    max-width: 180px;
    align-self: center;
    -unity-text-align: middle-left;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.header-bar .gear-button,
.header-bar .memory-button,
.header-bar .performance-analysis-button {
    margin-left: 4px;
}

.header-bar .credit-balance-button {
    min-width: 46px;
    flex-shrink: 0;
    height: 24px;
    min-height: 24px;
    margin-left: 4px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    border-width: 0;
    background-color: transparent;
    color: #a8a8a8;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.header-bar .credit-balance-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.header-bar .credit-balance--normal {
    color: #a8a8a8;
}

.header-bar .credit-balance--low {
    color: #e5b94d;
}

.header-bar .credit-balance--empty {
    color: #e57373;
}

.header-bar .credit-balance--unknown {
    color: #858585;
}

.header-bar .credit-balance-button.credit-balance--signing-in:disabled {
    min-width: 80px;
    color: #a8a8a8;
    opacity: 1;
}

/* ─── Shared Trigger Style ─── */
.xorin-trigger {
    background-color: transparent;
    border-width: 1px;
    border-color: #444;
    border-radius: 4px;
    color: #ccc;
    padding: 2px 8px;
}

.xorin-trigger:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: #666;
    color: white;
}

.xorin-trigger:disabled {
    border-color: #333;
    color: #555;
    background-color: transparent;
}

/* ─── Chat Scroll ─── */
#chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
}

#chat-scroll .unity-scroll-view__content-container {
    padding-bottom: 8px;
}

/* ─── Message Bubbles ─── */
.message-bubble {
    position: relative;
    align-self: stretch;
    margin: 4px 8px;
    padding: 8px 12px;
    border-radius: 8px;
}

.message-assistant-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.message-assistant-header {
    color: rgba(120, 170, 255, 0.85);
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.message-label {
    white-space: normal;
    color: rgba(255, 255, 255, 1);
}

.message-user {
    background-color: rgba(51, 102, 204, 0.9);
    padding-right: 34px;
}

.message-assistant {
    background-color: rgba(64, 64, 64, 0.9);
    padding-right: 34px;
}

.message-error {
    background-color: rgba(153, 26, 26, 0.9);
}

.message-status {
    align-self: center;
    background-color: rgba(76, 76, 76, 0.7);
    padding: 4px 8px;
}

.message-copy-button {
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 22px;
    min-width: 22px;
    height: 22px;
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    opacity: 0.35;
    transition-property: opacity, background-color;
    transition-duration: 0.12s;
}

.message-copy-button--top {
    bottom: auto;
    top: 6px;
}

.message-copy-button:hover,
.message-copy-button:focus {
    background-color: rgba(168, 199, 250, 0.15);
    opacity: 1;
}

.message-copy-button > .xorin-action-icon {
    opacity: 1;
}

/* ─── Input Bar ─── */
#input-bar {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-height: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: #1e1e1e;
    border-top-width: 1px;
    border-top-color: #2d2d30;
    overflow: hidden;
    align-items: stretch;
}

.input-shell {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    align-self: stretch;
    min-height: 40px;
    background-color: #292929;
    border-width: 1px;
    border-color: #3a3a3a;
    border-radius: 8px;
}

.composer-row {
    display: flex;
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    min-height: 24px;
    padding-top: 2px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    width:100%;
}

.composer-row-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.composer-row > .composer-text-button,
.composer-row > .composer-icon-button,
.composer-row-right > .composer-icon-button {
    flex-grow: 0;
    flex-shrink: 0;
}

.composer-row-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
    margin-left: auto;
}

.composer-row--narrow {
    flex-direction: row;
    align-items: center;
}

.composer-row--narrow .composer-row-left,
.composer-row--narrow .composer-row-right {
    width: auto;
    align-self: center;
}

.composer-row--narrow .composer-row-right {
    justify-content: flex-end;
    margin-left: auto;
    margin-top: 0;
}

.composer-row--narrow .auto-accept-label {
    display: none;
}

.composer-row--narrow .auto-accept-toggle {
    margin-left: 4px;
}

/* At very small widths, keep every control available in two balanced rows. */
.composer-row--compact {
    flex-direction: column;
    align-items: stretch;
}

.composer-row--compact .composer-row-left,
.composer-row--compact .composer-row-right {
    width: 100%;
    align-self: stretch;
}

.composer-row--compact .composer-row-left {
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
}

.composer-row--compact .composer-row-right {
    justify-content: flex-end;
    margin-left: 0;
    margin-top: 2px;
}

.composer-row--compact .auto-accept-toggle {
    margin-left: 6px;
    margin-right: auto;
}

.composer-row--compact .auto-accept-label {
    display: flex;
}

.composer-row-right > .send-button,
.composer-row-right > .stop-button {
    margin-left: 6px;
}

/* Phase 57: context-window usage ring and click-to-toggle breakdown */
.context-indicator {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 6px;
}

.context-indicator--neutral {
    color: #5A9FD4;
}

.context-indicator--info {
    color: #ECC94B;
}

.context-indicator--warn {
    color: #ED8936;
}

.context-indicator--danger {
    color: #E53E3E;
}

.context-indicator:focus {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

.context-indicator-popup {
    padding-top: 12px;
    padding-right: 14px;
    padding-bottom: 8px;
    padding-left: 14px;
    color: #C0C0C0;
}

.context-indicator-popup-header,
.context-indicator-popup-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.context-indicator-popup-header {
    margin-bottom: 7px;
    color: #E2E2E2;
    -unity-font-style: bold;
}

.context-indicator-popup-row {
    min-height: 18px;
    color: #C0C0C0;
}

.context-indicator-popup-value {
    margin-left: 10px;
    -unity-text-align: middle-right;
}

.context-indicator-popup-empty {
    color: #A8A8A8;
    white-space: normal;
}

.chat-input-body {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.composer-input-inline {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
}

.chat-input-placeholder {
    position: absolute;
    left: 10px;
    right: 8px;
    top: 6px;
    color: #808080;
    -unity-font-style: italic;
    white-space: normal;
}

#chat-input {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    border-radius: 0;
    color: #ececec;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 0;
    margin-right: 0;
    overflow: hidden;
    min-width: 0;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    align-self: flex-start;
    min-height: 30px;
}

#chat-input .unity-base-field__input,
#chat-input .unity-base-text-field,
#chat-input .unity-text-input {
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    border-radius: 0;
    color: #ececec;
    padding-left: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.input-shell--focused {
    background-color: #303030;
    border-color: rgba(77, 136, 221, 0.55);
}

.input-shell--drag-over {
    background-color: rgba(77, 136, 221, 0.12);
    border-color: rgba(77, 136, 221, 0.9);
}

.composer-drop-status {
    min-height: 18px;
    padding-left: 8px;
    padding-right: 8px;
    color: #9ABDEB;
    font-size: 11px;
    white-space: normal;
}

#chat-input .unity-text-field__input {
    overflow: hidden;
    white-space: normal;
    padding-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-right: 4px;
}

#chat-input .unity-scroller--vertical {
    width: 6px;
    margin-right: 12px;
}

#chat-input .unity-scroller--vertical .unity-slider__dragger {
    background-color: #4a4a4a;
    border-radius: 3px;
    border-width: 0;
}

#chat-input .unity-scroller--vertical .unity-slider__dragger:hover {
    background-color: #5e5e5e;
}

#chat-input:focus {
    border-color: transparent;
}

.composer-icon-button {
    margin-left: 0;
    margin-right: 0;
    border-radius: 4px;
    border-width: 0;
}

.composer-text-button {
    height: 24px;
    min-height: 24px;
    min-width: 52px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 0;
    margin-right: 0;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: #b0b0b0;
    -unity-text-align: middle-center;
}

.composer-text-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    color: #e0e0e0;
}

.settings-selector-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-width: 0;
    min-height: 24px;
    margin-bottom: 2px;
}

.settings-selector-label {
    width: 40%;
    min-width: 100px;
    flex-shrink: 0;
    color: #b0b0b0;
    -unity-text-align: middle-left;
}

.settings-selector-trigger {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    max-width: none;
}

.settings-selector-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: #b0b0b0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.settings-selector-arrow {
    width: 14px;
    min-width: 14px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 4px;
    color: #b0b0b0;
    -unity-text-align: middle-right;
}

.settings-selector-trigger:hover > .settings-selector-value,
.settings-selector-trigger:hover > .settings-selector-arrow {
    color: #e0e0e0;
}

.settings-toggle-control-column {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 24px;
    min-height: 24px;
}

.settings-toggle-control {
    margin: 0;
}

.settings-toggle-control > .unity-toggle__input {
    margin: 0;
}

.mode-trigger {
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.model-trigger {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 42px;
    max-width: 150px;
    margin-left: 6px;
    margin-right: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.model-trigger:disabled {
    opacity: 0.55;
}

.reasoning-effort-trigger {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 54px;
    max-width: 86px;
    margin-left: 4px;
    margin-right: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.reasoning-effort-trigger:disabled {
    opacity: 0.55;
}

.composer-row--narrow .model-trigger {
    max-width: 92px;
}

.composer-row--narrow .reasoning-effort-trigger {
    min-width: 48px;
    max-width: 76px;
    padding-left: 4px;
    padding-right: 4px;
}

.send-button {
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
    background-color: rgba(51, 102, 204, 0.45);
    border-width: 0;
}

.send-button:hover {
    background-color: rgba(68, 119, 221, 0.65);
}

.input-shell .composer-text-button.xorin-trigger {
    background-color: transparent;
    border-width: 0;
    border-radius: 4px;
    color: #b0b0b0;
}

.input-shell .composer-text-button.xorin-trigger:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    color: #e0e0e0;
}

.input-shell .composer-icon-button.send-button.xorin-trigger {
    background-color: rgba(51, 102, 204, 0.45);
    border-width: 0;
}

.input-shell .composer-icon-button.send-button.xorin-trigger:hover {
    background-color: rgba(68, 119, 221, 0.65);
    border-width: 0;
}

.input-shell .composer-icon-button.attach-button {
    background-color: transparent;
    border-width: 0;
}

.input-shell .composer-icon-button.attach-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
}

.stop-button {
    margin-right: 0;
    flex-shrink: 0;
    background-color: rgba(190, 58, 58, 0.9);
    border-width: 0;
}

.stop-button:hover {
    background-color: rgba(210, 72, 72, 1);
}

/* ─── Hidden ─── */
.hidden {
    display: none;
}

/* ─── Interrupted Indicator ─── */
.interrupted-indicator {
    color: #ff9900;
    -unity-font-style: italic;
    margin-top: 4px;
}

/* ─── Status Bubble ─── */
.message-status {
    align-self: center;
    background-color: rgba(48, 48, 48, 0.7);
}

/* ─── Scrollbar ─── */
#chat-scroll .unity-scroller--vertical {
    width: 8px;
}

#chat-scroll .unity-scroller--vertical .unity-slider__dragger {
    background-color: #555;
    border-radius: 4px;
}

#chat-scroll .unity-scroller--vertical .unity-slider__dragger:hover {
    background-color: #777;
}

/* ─── Chat History and Title ─── */
.chat-title-container {
    flex-direction: row;
    align-items: center;
}

.chat-title-label {
    -unity-font-style: bold;
    color: white;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ─── Memory Panel ─── */
.memory-panel {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    background-color: #1e1e1e;
}

.memory-panel-content {
    flex-grow: 1;
    min-height: 0;
    padding: 12px;
}

.memory-panel-description {
    color: #999;
    white-space: normal;
    margin-bottom: 10px;
}

.memory-rules-field {
    flex-grow: 1;
    min-height: 160px;
}

.memory-rules-field .unity-text-field__input {
    white-space: normal;
    -unity-text-align: upper-left;
}

.memory-panel-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
}

.memory-rules-count,
.memory-rules-status {
    color: #888;
}

.memory-rules-save {
    min-width: 64px;
}

.settings-account-button-row {
    flex-direction: row;
    align-items: center;
}

.settings-account-button {
    margin-left: 0;
    margin-right: 8px;
}

.settings-account-button--last {
    margin-right: 0;
}

.memory-rules-status {
    min-height: 14px;
    margin-top: 4px;
    white-space: normal;
}

/* ─── Settings Side Panel ─── */
.settings-side-panel {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    background-color: #1e1e1e;
}

.settings-side-panel-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-section-title {
    margin-top: 8px;
    margin-bottom: 4px;
}

.settings-helper-text {
    margin-top: 1px;
    margin-bottom: 5px;
    color: #999;
    white-space: normal;
}

/* ─── Chat History Panel ─── */
.chat-history-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: #1e1e1e;
}

.chat-history-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #3a3a3a;
}

.chat-history-header .xorin-panel-title {
    color: #ccc;
}

.chat-history-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-left-width: 3px;
    border-left-color: transparent;
}

.chat-history-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.chat-history-row-current {
    border-left-color: #3366cc;
    background-color: rgba(51, 102, 204, 0.1);
}

.chat-history-row-info {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.chat-history-title {
    -unity-font-style: bold;
    color: #ddd;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-history-timestamp {
    color: #888;
    margin-top: 2px;
}

.chat-history-rename-field {
    margin-bottom: 2px;
}

.chat-history-empty {
    color: #666;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    padding: 24px 12px;
}

/* ─── Shared anchored popup surfaces ─── */
.xorin-popup-surface {
    position: absolute;
    background-color: #292929;
    border-width: 1px;
    border-color: #444;
    border-radius: 8px;
    overflow: hidden;
}

.xorin-popup-trigger--active {
    background-color: rgba(255, 255, 255, 0.08);
}

.input-shell .composer-text-button.xorin-popup-trigger--active,
.input-shell .composer-icon-button.attach-button.xorin-popup-trigger--active,
.header-bar .credit-balance-button.xorin-popup-trigger--active {
    background-color: rgba(255, 255, 255, 0.08);
}

.input-shell.xorin-popup-trigger--active {
    background-color: #303030;
    border-color: rgba(77, 136, 221, 0.55);
}

.context-indicator.xorin-popup-trigger--active {
    border-radius: 4px;
}

.xorin-popup-menu-scroll {
    flex-grow: 0;
    flex-shrink: 1;
}

.xorin-popup-menu-scroll .unity-scroll-view__content-container {
    flex-grow: 0;
}

.xorin-popup-menu-row {
    flex-direction: row;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 10px;
    padding-right: 10px;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

.xorin-popup-menu-row:hover,
.xorin-popup-menu-row:focus {
    background-color: rgba(255, 255, 255, 0.08);
}

.xorin-popup-menu-row--selected {
    background-color: rgba(77, 153, 230, 0.18);
}

.xorin-popup-menu-row--selected:hover,
.xorin-popup-menu-row--selected:focus {
    background-color: rgba(77, 153, 230, 0.28);
}

.xorin-popup-menu-row--danger {
    color: #e57373;
}

.xorin-popup-menu-row--danger .xorin-popup-menu-label {
    color: #e57373;
}

.xorin-popup-menu-row--danger:hover,
.xorin-popup-menu-row--danger:focus {
    color: #ff8a80;
    background-color: rgba(204, 51, 51, 0.18);
}

.xorin-popup-menu-row--danger:hover .xorin-popup-menu-label,
.xorin-popup-menu-row--danger:focus .xorin-popup-menu-label {
    color: #ff8a80;
}

.xorin-popup-menu-label {
    flex-grow: 1;
    min-width: 0;
    color: #ddd;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.xorin-popup-menu-check {
    width: 18px;
    min-width: 18px;
    margin-left: 8px;
    color: #78aaff;
    -unity-text-align: middle-right;
}

.xorin-popup-menu-heading {
    padding-top: 6px;
    padding-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    color: #888;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.xorin-popup-menu-information {
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    color: #aaa;
    white-space: normal;
}

.xorin-popup-menu-separator {
    margin-left: 8px;
    margin-right: 8px;
    background-color: #3d3d3d;
}

/* ─── Plan Review Panel ─── */
.plan-review-panel {
    align-self: stretch;
    margin: 8px 12px;
    padding: 8px 10px;
    background-color: rgba(46, 56, 71, 1);
    border-radius: 6px;
    border-left-width: 2px;
    border-left-color: rgba(77, 153, 230, 1);
    overflow: hidden;
}

.plan-step-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding-left: 4px;
}

.plan-step-description {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    overflow: hidden;
    color: rgba(217, 217, 217, 1);
}

.plan-questions-header {
    -unity-font-style: bold;
    color: white;
    margin-bottom: 6px;
}

.plan-button-bar {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

/* ─── Clarifying Question View ─── */
.plan-question-option {
    background-color: rgba(64, 64, 77, 1);
    color: white;
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 4px 10px;
    border-radius: 12px;
    white-space: normal;
    -unity-text-align: upper-left;
    max-width: 100%;
    flex-shrink: 1;
    align-self: flex-start;
    height: auto;
}

.plan-question-option-selected {
    background-color: rgba(51, 128, 204, 1);
}

.plan-custom-answer-input {
    margin-top: 4px;
    background-color: rgba(38, 38, 46, 1);
    border-color: rgba(77, 77, 89, 1);
    border-radius: 4px;
    color: white;
    padding: 4px 8px;
}

/* ─── Plan Edit Controls ─── */
.plan-step-edit-btn {
    min-width: 28px;
    margin-left: 4px;
}

.plan-add-instruction-btn {
    margin-top: 4px;
    -unity-text-align: middle-left;
}

/* ─── Phase 33: @ Mention Autocomplete Popup ─── */

.mention-popup {
    overflow: hidden;
    padding: 4px 0;
}

.mention-popup-scroll {
    flex-grow: 0;
    flex-shrink: 1;
}

.mention-popup-scroll .unity-scroll-view__content-container {
    flex-grow: 0;
}

.mention-popup-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 0;
}

.mention-popup-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.mention-popup-row--selected {
    background-color: rgba(77, 153, 230, 0.3);
}

.mention-popup-row--selected:hover {
    background-color: rgba(77, 153, 230, 0.4);
}

.mention-popup-icon {
    width: 28px;
    flex-shrink: 0;
    color: #888;
    -unity-text-align: middle-center;
}

.mention-popup-name {
    flex-shrink: 0;
    color: #e0e0e0;
    -unity-font-style: bold;
    margin-right: 8px;
}

.mention-popup-path {
    flex-grow: 1;
    color: #777;
    overflow: hidden;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mention-popup-placeholder {
    padding: 8px 10px;
    color: #666;
    -unity-font-style: italic;
}

/* ─── Phase 33: Mention Chips Bar ─── */

.mention-chips-bar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    padding: 6px 8px 0 8px;
    margin: 0;
    background-color: transparent;
    border-top-width: 0;
}

.mention-chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 18px;
    min-height: 18px;
    background-color: rgba(77, 153, 230, 0.18);
    border-width: 0;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 2px;
    padding-right: 4px;
    margin: 4px 4px 2px 4px;
    overflow: hidden;
}

.mention-chip-icon {
    min-width: 16px;
    width: 16px;
    height: 14px;
    margin-right: 4px;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    -unity-font-style: bold;
    color: #d8e8ff;
    background-color: rgba(77, 136, 221, 0.55);
    -unity-text-align: middle-center;
}

.mention-chip-icon--script {
    color: #ffffff;
    background-color: rgba(77, 136, 221, 0.9);
}

.mention-chip-label {
    color: rgba(168, 208, 255, 1);
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1px;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    -unity-font-style: normal;
    white-space: nowrap;
}

.mention-chip-remove {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    color: rgba(128, 191, 255, 0.7);
    background-color: transparent;
    border-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 0;
    margin-left: 1px;
    margin-right: 0;
    opacity: 0;
    -unity-text-align: middle-center;
}

.mention-chip:hover .mention-chip-remove {
    opacity: 1;
}

.mention-chip-remove:hover {
    color: white;
    background-color: rgba(255, 255, 255, 0.1);
}

/* ─── Phase 34: GO / Selection / Console / Scene Hierarchy Mention Chips ─── */

/* GO chips - green tint */
.mention-chip--gameobject {
    background-color: rgba(77, 204, 153, 0.15);
}

.mention-chip--gameobject .mention-chip-icon {
    color: #e8fff4;
    background-color: rgba(77, 204, 153, 0.75);
}

.mention-chip--gameobject .mention-chip-label {
    color: rgba(128, 230, 179, 1);
}

.mention-chip--gameobject .mention-chip-remove {
    color: rgba(128, 230, 179, 0.7);
}

/* Selection chips - orange tint */
.mention-chip--selection {
    background-color: rgba(230, 170, 77, 0.15);
}

.mention-chip--selection .mention-chip-icon {
    color: #fff4e8;
    background-color: rgba(230, 170, 77, 0.75);
}

.mention-chip--selection .mention-chip-label {
    color: rgba(255, 200, 128, 1);
}

.mention-chip--selection .mention-chip-remove {
    color: rgba(255, 200, 128, 0.7);
}

/* Console chips - red tint */
.mention-chip--console {
    background-color: rgba(230, 77, 77, 0.15);
}

.mention-chip--console .mention-chip-label {
    color: rgba(255, 128, 128, 1);
}

.mention-chip--console .mention-chip-remove {
    color: rgba(255, 128, 128, 0.7);
}

/* Scene hierarchy chips - purple tint */
.mention-chip--scene_hierarchy {
    background-color: rgba(160, 120, 230, 0.15);
}

.mention-chip--scene_hierarchy .mention-chip-label {
    color: rgba(190, 160, 255, 1);
}

.mention-chip--scene_hierarchy .mention-chip-remove {
    color: rgba(190, 160, 255, 0.7);
}

/* ─── Phase 35: Impact Analysis Card ─── */

.impact-card {
    margin: 8px 12px;
    padding: 10px;
    background-color: rgba(46, 56, 46, 1);
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: rgba(100, 180, 100, 1);
    overflow: hidden;
}

/* Risk-level border variants */
.impact-card-risk-none {
    border-left-color: rgba(100, 180, 100, 1);
}

.impact-card-risk-low {
    border-left-color: rgba(100, 180, 100, 1);
}

.impact-card-risk-medium {
    border-left-color: rgba(230, 179, 51, 1);
}

.impact-card-risk-high {
    border-left-color: rgba(220, 80, 80, 1);
}

.impact-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.impact-title {
    -unity-font-style: bold;
    color: white;
    flex-grow: 1;
}

.impact-risk-badge {
    -unity-font-style: bold;
    padding: 2px 8px;
    border-radius: 8px;
    margin-left: 8px;
}

.impact-risk-none {
    background-color: rgba(100, 180, 100, 0.2);
    color: rgba(140, 210, 140, 1);
}

.impact-risk-low {
    background-color: rgba(100, 180, 100, 0.2);
    color: rgba(140, 210, 140, 1);
}

.impact-risk-medium {
    background-color: rgba(230, 179, 51, 0.2);
    color: rgba(255, 210, 100, 1);
}

.impact-risk-high {
    background-color: rgba(220, 80, 80, 0.2);
    color: rgba(255, 120, 120, 1);
}

.impact-risk-unknown {
    background-color: rgba(128, 128, 128, 0.2);
    color: rgba(180, 180, 180, 1);
}

.impact-section {
    margin-top: 4px;
    margin-left: 4px;
}

.impact-row {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    margin-bottom: 2px;
    padding: 2px 4px;
}

.impact-row-clickable:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
}

.impact-row-badge {
    -unity-font-style: bold;
    padding: 1px 6px;
    border-radius: 3px;
    margin-right: 6px;
}

.impact-badge-inherits {
    background-color: rgba(220, 80, 80, 0.15);
    color: rgba(255, 140, 140, 1);
}

.impact-badge-imports {
    background-color: rgba(77, 153, 230, 0.15);
    color: rgba(128, 179, 230, 1);
}

.impact-badge-field-type {
    background-color: rgba(230, 150, 50, 0.15);
    color: rgba(255, 190, 100, 1);
}

.impact-row-name {
    color: rgba(217, 217, 217, 1);
    margin-right: 6px;
    -unity-font-style: bold;
}

.impact-row-path {
    color: rgba(128, 128, 128, 1);
    flex-grow: 1;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

.impact-summary {
    -unity-font-style: italic;
    color: rgba(150, 150, 150, 1);
    margin-top: 6px;
    white-space: normal;
}

/* ── Phase 58e: Expandable Changelog Script Diffs ── */

.changelog-script-diff {
    margin-left: 8px;
    margin-right: 8px;
    color: rgba(200, 205, 214, 1);
}

.changelog-diff-content {
    max-height: 260px;
    padding: 0;
    margin-left: 12px;
    background-color: rgba(25, 27, 30, 1);
}

.diff-hunk-header {
    color: rgba(130, 150, 200, 1);
    background-color: rgba(30, 35, 50, 1);
    padding: 2px 10px;
    -unity-font-style: italic;
}

.changelog-diff-empty {
    color: rgba(140, 144, 150, 1);
    padding: 10px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
}

.diff-line {
    flex-direction: row;
    padding: 0 10px;
    min-height: 15px;
    transition-property: background-color;
    transition-duration: 0.08s;
}

.diff-line:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.diff-line-add:hover {
    background-color: rgba(36, 70, 36, 1);
}

.diff-line-remove:hover {
    background-color: rgba(70, 36, 36, 1);
}

.diff-line-add {
    background-color: rgba(30, 60, 30, 1);
    border-left-width: 2px;
    border-left-color: rgba(110, 200, 120, 0.65);
}

.diff-line-remove {
    background-color: rgba(60, 30, 30, 1);
    border-left-width: 2px;
    border-left-color: rgba(220, 110, 110, 0.65);
}

.diff-line-number {
    width: 28px;
    min-width: 28px;
    color: rgba(100, 100, 100, 1);
    -unity-text-align: middle-right;
    padding-right: 3px;
}

.diff-line-text {
    color: rgba(200, 200, 200, 1);
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-overflow-position: end;
}

/* ── Shared inline chat card shell ── */

.chat-card {
    align-self: stretch;
    margin: 6px 10px;
    padding: 0;
    background-color: rgba(30, 32, 34, 1);
    border-radius: 5px;
    border-left-width: 2px;
    border-left-color: rgba(110, 120, 135, 0.75);
    overflow: hidden;
    transition-property: border-left-color, opacity;
    transition-duration: 0.15s;
}

.chat-card--pending {
    border-left-color: rgba(180, 140, 60, 0.65);
}

.chat-card--pending:hover {
    border-left-color: rgba(210, 170, 80, 1);
}

.chat-card--information {
    border-left-color: rgba(77, 153, 230, 0.8);
}

.chat-card--information:hover {
    border-left-color: rgba(105, 175, 245, 1);
}

.chat-card-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(40, 44, 50, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 64, 70, 1);
}

.chat-card-title {
    -unity-font-style: bold;
    color: rgba(210, 210, 210, 1);
    flex-shrink: 0;
}

.chat-card-meta {
    margin-left: 8px;
    min-width: 0;
    color: rgba(150, 158, 170, 1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.chat-card-spacer {
    flex-grow: 1;
    min-width: 6px;
}

.chat-card-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.chat-card-details {
    padding: 2px 10px 6px 10px;
}

.chat-card-message {
    padding: 5px 0;
    color: rgba(170, 170, 170, 1);
    -unity-font-style: italic;
}

/* ── Phase 50: Change Log Bar ── */

.changelog-resolved {
    opacity: 0.7;
}

.changelog-resolved:hover {
    border-left-color: rgba(180, 140, 60, 0.65);
}

.changelog-header {
    flex-direction: column;
    align-items: stretch;
}

.changelog-outcome-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-width: 0;
    min-height: 24px;
}

.changelog-status-row {
    padding: 5px 10px;
}

.changelog-outcome-gutter {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.changelog-actions {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-wrap: wrap;
}

.changelog-summary-content,
.tool-activity-issue-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-wrap: wrap;
}

.changelog-details-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.changelog-scope-label {
    margin-top: 6px;
    margin-bottom: 2px;
    color: rgba(155, 165, 180, 1);
    -unity-font-style: bold;
}

.changelog-scope-label-first {
    margin-top: 0;
}

.changelog-status {
    flex-grow: 1;
    flex-shrink: 1;
}

.changelog-summary-icon {
    color: rgba(155, 170, 190, 0.9);
}

.changelog-status--accepted {
    color: rgba(120, 200, 120, 1);
}

.changelog-status--undone {
    color: rgba(230, 179, 51, 1);
}

.changelog-status--error {
    color: rgba(220, 100, 100, 1);
}

.changelog-row {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
    padding: 2px 0;
}

.changelog-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-top: 4px;
    margin-right: 6px;
    flex-shrink: 0;
}

.changelog-dot--ok {
    background-color: rgba(100, 190, 100, 1);
}

.changelog-dot--fail {
    background-color: rgba(200, 80, 80, 1);
}

.changelog-row-content {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.changelog-desc {
    color: rgba(190, 190, 190, 1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
    min-width: 0;
}

.changelog-file {
    color: rgba(140, 140, 140, 1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 6px;
    flex-shrink: 1;
    min-width: 0;
}

.changelog-stats {
    color: rgba(140, 180, 140, 1);
}

/* ── Phase 41l: Attach button + Attachment bar ── */

.attach-button {
    flex-shrink: 0;
    border-width: 0;
    margin-left: 0;
    margin-right: 0;
}

.attachment-bar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    padding: 4px 8px 0 8px;
    margin: 0;
    background-color: transparent;
}

.attachment-chip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 24px;
    min-height: 24px;
    background-color: rgba(77, 153, 230, 0.15);
    border-width: 0;
    border-radius: 4px;
    padding: 2px 4px 2px 2px;
    margin: 2px 4px 2px 0;
    overflow: hidden;
}

.attachment-chip-thumb {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border-radius: 3px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.attachment-chip-name {
    color: rgba(168, 208, 255, 1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
    margin-right: 2px;
}

.attachment-chip-remove {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    background-color: transparent;
    border-width: 0;
    border-radius: 7px;
    padding: 0;
    margin-left: 1px;
    opacity: 0;
}

.attachment-chip:hover .attachment-chip-remove {
    opacity: 1;
}

.attachment-chip-remove:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* ── Mention chips in user message bubbles ── */

.message-mention-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.message-mention-chips .mention-chip {
    max-width: 100%;
    flex-shrink: 1;
}

.message-mention-chips .mention-chip-label {
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Phase 41l: Message attachment display in user bubbles ── */

.message-attachments {
    flex-direction: column;
    margin-bottom: 6px;
}

.message-attachment-card {
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px;
    margin-bottom: 4px;
    overflow: hidden;
}

.message-attachment-preview {
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 2px;
}

.message-attachment-icon {
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
}

.message-attachment-name {
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 200px;
}

/* ── Phase 52: Auto-Accept toggle button in composer row ── */

.auto-accept-toggle {
    flex-direction: row;
    align-items: center;
    height: 24px;
    min-height: 24px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin-left: 8px;
}

.auto-accept-label {
    color: rgba(123, 123, 123, 1);
    white-space: nowrap;
    margin-right: 6px;
}

.auto-accept-toggle:hover .auto-accept-label {
    color: rgba(153, 153, 153, 1);
}

.auto-accept-toggle.auto-accept-active .auto-accept-label {
    color: rgba(154, 154, 154, 1);
}

.auto-accept-track {
    width: 30px;
    height: 16px;
    background-color: rgba(60, 60, 60, 1);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
}

.auto-accept-toggle:hover .auto-accept-track {
    background-color: rgba(72, 72, 72, 1);
    border-color: rgba(255, 255, 255, 0.18);
}

.auto-accept-toggle.auto-accept-active .auto-accept-track {
    background-color: rgba(40, 90, 160, 0.7);
    border-color: rgba(80, 140, 220, 0.5);
}

.auto-accept-thumb {
    width: 12px;
    height: 12px;
    background-color: rgba(160, 160, 160, 1);
    border-radius: 6px;
    position: absolute;
    top: 1px;
    left: 1px;
    transition-property: left;
    transition-duration: 0.15s;
}

.auto-accept-toggle.auto-accept-active .auto-accept-thumb {
    background-color: rgba(255, 255, 255, 1);
    left: 15px;
}

/* ── Tool Activity ── */

.tool-activity-summary {
    align-self: stretch;
    height: 24px;
    min-height: 24px;
    padding-left: 0;
    padding-right: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(190, 190, 190, 1);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tool-activity-summary:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.tool-activity-issue-summary {
    min-height: 24px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-left;
}

.tool-activity-issue-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-width: 0;
}

.tool-activity-issue-row .tool-activity-issue-summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.tool-activity-header-row .tool-activity-summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.tool-activity-disclosure-icon {
    color: rgba(155, 170, 190, 0.75);
}

.tool-activity-view-details {
    flex-shrink: 0;
    margin-left: 6px;
}

.tool-activity-issue-summary--warning {
    color: rgba(230, 180, 80, 1);
}

.tool-activity-issue-summary--failed {
    color: rgba(230, 100, 100, 1);
}

.tool-activity-rows {
    flex-direction: column;
}

.current-status-view {
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding-left: 5px;
    padding-right: 4px;
}

.current-status-spinner {
    width: 11px;
    height: 11px;
    min-width: 11px;
    margin-left: 3px;
    margin-right: 6px;
    border-radius: 6px;
    border-width: 1.5px;
    border-top-color: rgba(130, 170, 230, 0.9);
    border-right-color: rgba(130, 170, 230, 0.9);
    border-bottom-color: rgba(130, 170, 230, 0.18);
    border-left-color: rgba(130, 170, 230, 0.18);
}

.current-status-label {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgba(150, 165, 185, 1);
    -unity-font-style: italic;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.inline-tool-call {
    align-self: stretch;
    flex-direction: column;
    margin-top: 1px;
    margin-bottom: 1px;
}

.script-verification-row {
    margin-top: 3px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(80, 120, 175, 0.08);
    border-left-width: 1px;
    border-left-color: rgba(100, 145, 205, 0.45);
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.script-verification-row .tool-row-label {
    color: rgba(165, 185, 210, 1);
}

.inline-tool-header {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 3px;
}

.tool-icon-container {
    width: 18px;
    height: 18px;
    min-width: 18px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.tool-spinner {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-top-color: rgba(77, 153, 230, 0.9);
    border-right-color: rgba(77, 153, 230, 0.9);
    border-bottom-color: rgba(77, 153, 230, 0.15);
    border-left-color: rgba(77, 153, 230, 0.15);
}

.tool-icon-success {
    -unity-font-style: bold;
    color: rgba(74, 222, 128, 1);
    -unity-text-align: middle-center;
    width: 18px;
    height: 18px;
}

.tool-icon-failed {
    -unity-font-style: bold;
    color: rgba(248, 113, 113, 1);
    -unity-text-align: middle-center;
    width: 18px;
    height: 18px;
}

.tool-row-label {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgba(170, 170, 170, 1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-left: 2px;
}

.tool-row-time {
    color: rgba(128, 128, 128, 1);
    flex-shrink: 0;
    margin-left: 4px;
    -unity-text-align: middle-right;
}

/* ─── Phase 53a: Asset Generation Clarification Card ─── */

.clarification-card {
    margin: 6px 10px;
    padding: 0;
    background-color: rgba(30, 32, 34, 1);
    border-radius: 5px;
    border-left-width: 2px;
    border-left-color: rgba(180, 140, 60, 0.65);
    overflow: hidden;
    transition-property: border-left-color, opacity;
    transition-duration: 0.15s;
}

.clarification-card:hover {
    border-left-color: rgba(210, 170, 80, 1);
}

.clarification-card-resolved {
    opacity: 0.7;
}

.clarification-card-resolved:hover {
    border-left-color: rgba(180, 140, 60, 0.65);
}

.clarification-card-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(40, 44, 50, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 64, 70, 1);
}

.clarification-card-header-label {
    -unity-font-style: bold;
    color: rgba(220, 190, 120, 1);
    flex-grow: 1;
}

.clarification-card-prompt {
    color: rgba(170, 170, 170, 1);
    padding: 4px 10px;
    -unity-font-style: italic;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    border-bottom-width: 1px;
    border-bottom-color: rgba(50, 54, 60, 1);
}

.clarification-field-group {
    padding: 6px 10px 4px 10px;
}

.clarification-field-label {
    -unity-font-style: bold;
    color: rgba(180, 180, 180, 1);
    margin-bottom: 4px;
}

.clarification-radio-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.clarification-radio-btn {
    background-color: rgba(50, 52, 58, 1);
    color: rgba(170, 170, 170, 1);
    border-radius: 3px;
    padding: 3px 10px;
    margin-right: 4px;
    margin-bottom: 3px;
    border-width: 1px;
    border-color: rgba(70, 72, 78, 1);
    transition-property: background-color, border-color, color;
    transition-duration: 0.1s;
}

.clarification-radio-btn:hover {
    background-color: rgba(64, 68, 76, 1);
    border-color: rgba(95, 100, 110, 1);
    color: rgba(220, 220, 220, 1);
}

.clarification-radio-btn--selected {
    background-color: rgba(50, 70, 100, 1);
    color: rgba(180, 210, 255, 1);
    border-color: rgba(80, 120, 180, 1);
}

.clarification-radio-btn--selected:hover {
    background-color: rgba(60, 80, 115, 1);
    border-color: rgba(100, 145, 210, 1);
}

.clarification-custom-text {
    margin-top: 3px;
    margin-bottom: 3px;
    height: 22px;
    background-color: rgba(40, 42, 48, 1);
    color: rgba(200, 200, 200, 1);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(70, 72, 78, 1);
}

.clarification-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.clarification-slider {
    flex-grow: 1;
    margin-right: 6px;
}

.clarification-slider-value {
    color: rgba(180, 210, 255, 1);
    min-width: 50px;
    -unity-text-align: middle-right;
}

.clarification-skip-btn {
    background-color: rgba(50, 52, 58, 1);
    color: rgba(150, 150, 150, 1);
    border-radius: 3px;
    padding: 2px 8px;
    margin-left: 6px;
    border-width: 1px;
    border-color: rgba(70, 72, 78, 1);
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.clarification-skip-btn:hover {
    background-color: rgba(64, 68, 76, 1);
    border-color: rgba(95, 100, 110, 1);
}

.clarification-skip-btn--active {
    background-color: rgba(50, 70, 100, 1);
    color: rgba(180, 210, 255, 1);
    border-color: rgba(80, 120, 180, 1);
}

.clarification-card-actions {
    flex-direction: row;
    align-items: center;
    padding: 5px 10px;
    background-color: rgba(35, 38, 42, 1);
    border-top-width: 1px;
    border-top-color: rgba(50, 54, 60, 1);
}

.clarification-resolved-label {
    padding: 5px 10px;
    -unity-font-style: italic;
}

.clarification-resolved-confirmed {
    color: rgba(120, 200, 120, 1);
}

.clarification-resolved-cancelled {
    color: rgba(220, 130, 130, 1);
}

.clarification-resolved-timeout {
    color: rgba(180, 180, 100, 1);
}

.clarification-resolved-interrupted {
    color: rgba(130, 130, 130, 1);
}
/* ─── Phase 53d: Asset Generation Preview Card ─── */

.preview-card {
    margin: 6px 10px;
    padding: 0;
    background-color: rgba(30, 32, 34, 1);
    border-radius: 5px;
    border-left-width: 2px;
    border-left-color: rgba(180, 140, 60, 0.65);
    overflow: hidden;
    transition-property: border-left-color, opacity;
    transition-duration: 0.15s;
}

.preview-card:hover {
    border-left-color: rgba(210, 170, 80, 1);
}

.preview-card-resolved {
    opacity: 0.7;
}

.preview-card-resolved:hover {
    border-left-color: rgba(180, 140, 60, 0.65);
}

.preview-card-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(40, 44, 50, 1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(60, 64, 70, 1);
}

.preview-card-header-label {
    -unity-font-style: bold;
    color: rgba(220, 190, 120, 1);
    flex-grow: 1;
    white-space: normal;
}

.preview-card-round-label {
    color: rgba(170, 170, 170, 1);
}

.preview-card-instruction {
    padding: 7px 10px 0 10px;
    color: rgba(180, 180, 180, 1);
    white-space: normal;
}

.preview-card-thumb-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 10px;
    justify-content: center;
}

.preview-card-thumb-option {
    position: relative;
    margin: 4px;
    border-radius: 8px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 150px;
    min-width: 120px;
    max-width: 220px;
}

.preview-card-thumb {
    width: 100%;
    height: 180px;
    border-radius: 6px;
    border-width: 3px;
    border-color: rgba(51, 51, 51, 0.4);
    margin: 0;
    cursor: link;
    transition-property: scale;
    transition-duration: 0.1s;
    -unity-background-scale-mode: scale-to-fit;
}

.preview-card-thumb--selected {
    border-width: 4px;
    border-color: rgba(50, 145, 255, 1);
}

.preview-card-thumb-option--selected {
    background-color: rgba(50, 145, 255, 0.18);
}

.preview-card-thumb-check {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(45, 135, 245, 1);
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.preview-card-thumb-view {
    position: absolute;
    left: 6px;
    bottom: 6px;
    height: 24px;
    min-width: 42px;
    padding: 2px 7px;
    font-size: 10px;
    background-color: rgba(20, 24, 30, 0.92);
}

.preview-card-thumb:hover {
    scale: 1.05;
}

.preview-card-revision {
    margin: 0 10px 10px 10px;
    background-color: transparent;
    flex-direction: column;
}

.preview-card-revision > .unity-text-field__label {
    min-width: 0;
    width: auto;
    color: rgba(170, 170, 170, 1);
    -unity-font-style: italic;
    margin-right: 0;
    margin-bottom: 4px;
    padding: 0;
}

.preview-card-revision > .unity-text-field__input {
    background-color: rgba(20, 22, 24, 1);
    border-color: rgba(60, 64, 70, 1);
    border-radius: 4px;
    color: rgba(210, 210, 210, 1);
    padding: 4px 6px;
}

.preview-card-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 5px 10px;
    background-color: rgba(35, 38, 42, 1);
    border-top-width: 1px;
    border-top-color: rgba(60, 64, 70, 1);
    justify-content: flex-end;
}

.preview-card-actions > .preview-action-use {
    width: 100%;
    margin-left: 0;
    margin-bottom: 4px;
}

.preview-card-actions > .preview-action-regen,
.preview-card-actions > .preview-action-cancel {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.preview-card-actions > .preview-action-regen {
    flex-basis: 110px;
    margin-left: 0;
}

.preview-card-actions > .preview-action-cancel {
    flex-basis: 60px;
}

.preview-resolved-label {
    -unity-font-style: bold;
    padding: 8px 10px;
    -unity-text-align: middle-center;
    background-color: rgba(35, 38, 42, 1);
    border-top-width: 1px;
    border-top-color: rgba(60, 64, 70, 1);
}

.preview-generation-status {
    color: rgba(120, 190, 255, 1);
    -unity-text-align: middle-left;
}

.preview-generation-hint {
    padding: 0 10px 9px 10px;
    color: rgba(165, 165, 165, 1);
}

.preview-card-generating {
    border-left-color: rgba(50, 145, 255, 0.9);
}

/* Full-size 3D reference image viewer */

.preview-viewer-root {
    flex-grow: 1;
    padding: 8px;
    background-color: rgba(24, 26, 29, 1);
}

.preview-viewer-toolbar {
    flex-direction: row;
    align-items: center;
    padding-bottom: 8px;
}

.preview-viewer-counter {
    min-width: 96px;
    margin: 0 8px;
    -unity-text-align: middle-center;
    color: rgba(210, 210, 210, 1);
}

.preview-viewer-scroll {
    flex-grow: 1;
    min-height: 240px;
    background-color: rgba(14, 16, 18, 1);
    border-width: 1px;
    border-color: rgba(60, 64, 70, 1);
    border-radius: 4px;
}

.preview-viewer-image {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.preview-viewer-status {
    min-height: 22px;
    padding: 5px 2px 2px 2px;
}

.preview-viewer-actions {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 6px;
}

.preview-resolved-selected { color: rgba(120, 200, 120, 1); }
.preview-resolved-regenerated { color: rgba(100, 160, 240, 1); }
.preview-resolved-timeout { color: rgba(200, 160, 100, 1); }
.preview-resolved-cancelled, .preview-resolved-interrupted { color: rgba(200, 100, 100, 1); }

/* Phase 60b — local runtime performance report */

.runtime-performance-card-summary {
    max-width: 220px;
}

.runtime-performance-card-details {
    padding-top: 3px;
}

.runtime-performance-card-section {
    margin-top: 5px;
    margin-bottom: 2px;
    color: rgba(170, 184, 202, 1);
    -unity-font-style: bold;
}

.runtime-performance-card-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 4px 0;
}

.runtime-performance-card-metric-name {
    width: 92px;
    min-width: 92px;
    color: #9ca7b5;
}

.runtime-performance-card-values {
    flex-grow: 1;
    min-width: 0;
}

.runtime-performance-card-value {
    color: #e0e5ec;
}

.runtime-performance-card-detail {
    color: #8f9aa8;
    white-space: normal;
}

.runtime-performance-card-anomalies {
    margin-top: 4px;
    color: #aab8c9;
}

.runtime-performance-card-anomaly {
    min-width: 0;
    margin: 3px 0 3px 14px;
    padding: 5px 7px;
    background-color: rgba(42, 46, 52, 0.7);
    border-left-width: 2px;
    border-left-color: rgba(118, 137, 164, 0.75);
    color: #cbd3dd;
    white-space: normal;
}

.runtime-performance-card-warnings {
    min-width: 0;
    padding: 6px 9px;
    margin-top: 3px;
    background-color: rgba(66, 54, 34, 0.55);
    border-top-width: 1px;
    border-top-color: rgba(105, 83, 45, 0.8);
    color: #d7bb7d;
}

.runtime-performance-card-warnings > .unity-label {
    min-width: 0;
    white-space: normal;
}

/* Phase 74B — cohesive assistant turns */

.assistant-turn {
    position: relative;
    align-self: stretch;
    flex-direction: column;
    min-width: 0;
    margin: 4px 8px;
    padding: 8px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.065);
    border-radius: 8px;
    background-color: rgba(48, 48, 48, 0.78);
    overflow: hidden;
}

.assistant-turn-header {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    margin-bottom: 6px;
}

.assistant-turn-header-spacer {
    flex-grow: 1;
    min-width: 6px;
}

.assistant-turn-copy {
    position: relative;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    flex-shrink: 0;
}

.assistant-turn-copy:disabled {
    opacity: 0;
}

.assistant-turn:hover > .assistant-turn-header > .assistant-turn-copy,
.message-user:hover > .message-copy-button {
    opacity: 1;
}

.assistant-turn-working {
    padding-left: 4px;
    padding-right: 4px;
}

.assistant-turn-body,
.assistant-turn-outcome {
    align-self: stretch;
    min-width: 0;
}

.assistant-turn-outcome {
    margin-top: 4px;
}

.assistant-turn-has-outcome .assistant-turn-outcome {
    margin-top: 7px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.assistant-turn .message-assistant--embedded {
    margin: 0;
    padding: 0;
    padding-right: 0;
    border-radius: 0;
    background-color: transparent;
}

.assistant-turn .message-assistant--embedded > .message-assistant-header-row,
.assistant-turn .message-assistant--embedded > .message-copy-button,
.assistant-turn .plan-review-panel > .message-assistant-header-row {
    display: none;
}

.assistant-turn .message-error {
    margin-left: 0;
    margin-right: 0;
}

.tool-activity-block {
    flex-direction: column;
    padding: 4px 8px;
    margin-top: 4px;
    margin-bottom: 4px;
    background-color: rgba(46, 46, 46, 0.6);
    border-left-width: 2px;
    border-left-color: rgba(102, 153, 230, 0.5);
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.assistant-turn-outcome > .tool-activity-block {
    margin: 0;
    padding: 1px 0;
    background-color: transparent;
    border-left-width: 0;
    border-radius: 0;
}

.assistant-turn-outcome > .tool-activity-block .tool-activity-summary {
    padding-left: 0;
    padding-right: 0;
    color: rgba(198, 198, 198, 0.9);
}

.assistant-turn-outcome > .tool-activity-block .tool-activity-issue-summary {
    padding-left: 0;
    padding-right: 0;
}

.assistant-turn-has-checkpoint .assistant-turn-outcome .tool-icon-success {
    color: rgba(155, 170, 190, 0.9);
}

.assistant-embedded-result {
    align-self: stretch;
    min-width: 0;
    background-color: transparent;
    border-left-width: 0;
}

.assistant-turn-body > .impact-card {
    margin: 2px 0;
    padding: 6px 0;
    background-color: transparent;
    border-left-width: 0;
    border-radius: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.asset-preview-group {
    align-self: stretch;
    min-width: 0;
    margin: 3px 0;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.asset-preview-group-title {
    color: #9ca7b5;
    margin-bottom: 3px;
}

.asset-preview-group-items {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    min-width: 0;
}

.asset-preview-item {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 180px;
    padding: 7px;
    margin: 2px;
    border-radius: 5px;
    background-color: rgba(30, 32, 34, 0.45);
}

.asset-preview-thumbnail {
    background-color: rgba(22, 24, 27, 1);
    border-radius: 4px;
}

.asset-preview-info {
    min-width: 0;
}

.asset-preview-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.asset-preview-actions > Button {
    margin-right: 4px;
    margin-bottom: 2px;
}

.plan-review-resolved,
.clarification-card-resolved,
.preview-card-resolved {
    background-color: transparent;
    border-left-width: 0;
}

.plan-review-resolved {
    padding: 4px 0;
}

.plan-resolved-summary {
    padding: 3px 0;
}

.preview-card-resolved .preview-card-thumb-row {
    justify-content: flex-start;
    padding: 5px 10px;
}

.preview-card-resolved .preview-card-thumb {
    width: 96px;
    height: 96px;
    border-width: 0;
    margin: 0;
    scale: 1 1;
    cursor: link;
}

.preview-card-resolved .preview-card-thumb-option {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 96px;
    min-width: 96px;
    max-width: 96px;
}

.preview-card-resolved .preview-resolved-label {
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    padding-top: 4px;
}

.clarification-card-resolved .clarification-card-header,
.preview-card-resolved .preview-card-header {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}

.assistant-turn-body > .plan-review-panel,
.assistant-turn-body > .clarification-card,
.assistant-turn-body > .preview-card {
    align-self: stretch;
    margin: 3px 0;
}

.assistant-turn-body > .plan-review-resolved,
.assistant-turn-body > .clarification-card-resolved,
.assistant-turn-body > .preview-card-resolved {
    margin: 1px 0;
    border-radius: 0;
}

.assistant-turn-outcome > .changelog-bar {
    margin: 2px 0 0 0;
    padding: 0;
    background-color: transparent;
    border-left-width: 0;
    border-radius: 0;
    opacity: 1;
}

.assistant-turn-outcome > .changelog-bar:hover {
    border-left-width: 0;
}

.assistant-turn-outcome > .changelog-bar > .changelog-header {
    flex-direction: column;
    align-items: stretch;
    padding: 2px 0;
    background-color: transparent;
    border-bottom-width: 0;
}

.assistant-turn-outcome .changelog-outcome-row {
    padding: 1px 0;
}

.assistant-turn-outcome .changelog-summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.assistant-turn-outcome .changelog-actions-row {
    align-items: flex-start;
}

.assistant-turn-outcome > .changelog-bar > .changelog-details {
    align-items: stretch;
    margin-top: 2px;
    padding: 1px 4px 3px 4px;
}

.assistant-turn-outcome .changelog-details-content {
    padding-left: 0;
}

.assistant-turn-outcome .changelog-details-gutter {
    height: auto;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
}

.changelog-actions,
.plan-button-bar,
.clarification-card-actions,
.preview-card-actions {
    flex-wrap: wrap;
}

.runtime-performance-card-header {
    flex-wrap: wrap;
}
